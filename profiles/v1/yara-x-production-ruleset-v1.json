    {
      "identifier": "impresari_pe_encoded_powershell_strings_v1",
      "purpose": "Observe a PE-like byte sequence containing an encoded PowerShell process-launch string combination",
      "category": "encoded_command_launcher_strings",
      "supported_formats": ["pe_candidate", "binary"],
      "supported_classes": ["executable", "library", "installer"],
      "tags": ["impresari", "observation_only", "pe_candidate"],
      "pattern_count": 4,
      "known_false_positives": [
        "security tools, test binaries, or installers can embed all four strings"
      ],
      "blind_spots": [
        "renamed launchers, alternate process APIs, decoded-only commands, and string obfuscation are not observed"
      ],
      "fixtures": [
        {"role": "positive", "path": "tests/yara-x-production-ruleset/generated/pe-encoded-powershell-positive.fixture", "sha256": "sha256:a1a78696483ea50ef77d8618b102d1a0249b101cdefa7b1a17accd2eb53ac046", "bytes": 108, "expected": "match"},
        {"role": "near_miss", "path": "tests/yara-x-production-ruleset/generated/pe-encoded-powershell-near-miss.fixture", "sha256": "sha256:2dbe134374e22e60e54f3a9e7e3514a7dbdd06d24c6c52af81bb5a01dd86ebd8", "bytes": 103, "expected": "no_match"},
        {"role": "benign_collision", "path": "tests/yara-x-production-ruleset/generated/pe-encoded-powershell-benign-collision.fixture", "sha256": "sha256:5b2f37267c7d788fa2892222eca7a336f9eb0ab73c41fd8c874ab447091d2734", "bytes": 118, "expected": "no_match"},
