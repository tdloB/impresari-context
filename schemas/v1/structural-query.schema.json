{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/structural-query.schema.json",
  "title": "Bounded structural graph traversal result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "graph_id", "workspace_snapshot", "start_node", "nodes", "edges", "truncated", "unknowns"],
  "properties": {
    "schema_name": {"const": "structural-query-result"},
    "schema_version": {"const": "1.0.0"},
    "graph_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "start_node": {"$ref": "common.schema.json#/$defs/sha256"},
    "nodes": {"type": "array", "maxItems": 10000, "items": {"$ref": "structural-graph.schema.json#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 10000, "items": {"$ref": "structural-graph.schema.json#/$defs/edge"}},
    "truncated": {"type": "boolean"},
    "unknowns": {"$ref": "common.schema.json#/$defs/stringList"}
  }
}
