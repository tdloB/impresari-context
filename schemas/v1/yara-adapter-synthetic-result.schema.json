{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/yara-adapter-synthetic-result.schema.json",
  "title": "ADR-0095 production-shaped original-synthetic YARA adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "fixture_id", "profile_id", "profile_digest", "workspace_snapshot", "manifest_id", "analyzer_id", "executable_digest", "ruleset_digest", "completed_at", "artifacts", "observations", "result_origin", "complete_accounting", "analyzer_executed", "authority_added"],
  "properties": {
    "schema_name": {"const": "yara-adapter-synthetic-result"},
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "profile_id": {"const": "yara-adapter-contract-v1"},
    "profile_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "analyzer_id": {"const": "impresari.yara"},
    "executable_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "ruleset_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "completed_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "observations": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/observation"}},
    "result_origin": {"const": "original_synthetic_fixture"},
    "complete_accounting": {"const": true},
    "analyzer_executed": {"const": false},
    "authority_added": {"const": false}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_hash", "bytes", "status"],
      "properties": {
        "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "status": {"type": "string", "enum": ["synthetic_match_fixture", "synthetic_no_match_fixture", "synthetic_unsupported_fixture"]}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_hash", "namespace", "rule_identifier", "tags", "ranges"],
      "properties": {
        "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "namespace": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "rule_identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "tags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}},
        "ranges": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/range"}}
      }
    },
    "range": {
      "type": "object", "additionalProperties": false,
      "required": ["string_identifier", "offset", "length"],
      "properties": {
        "string_identifier": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "offset": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "length": {"$ref": "common.schema.json#/$defs/unsignedDecimal"}
      }
    }
  }
}
