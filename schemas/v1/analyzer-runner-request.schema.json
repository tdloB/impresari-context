{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/analyzer-runner-request.schema.json",
  "title": "IAR-0 closed synthetic worker request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "request_id", "occurred_at", "deadline_at", "workspace_snapshot", "assessment_plan_id", "policy_id", "manifest_id", "capability_ids", "artifacts", "resource_profile_id", "resource_profile_digest", "synthetic_behavior", "source_paths_included", "commands_included", "network_destinations_included", "credentials_included", "authority_added"],
  "properties": {
    "schema_name": {"const": "analyzer-runner-request"},
    "schema_version": {"const": "1.0.0"},
    "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "occurred_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "deadline_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "assessment_plan_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "policy_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "capability_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/schemaName"}},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "resource_profile_id": {"const": "iar-protocol-synthetic-v1"},
    "resource_profile_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "synthetic_behavior": {"type": "string", "enum": ["no_op", "crash", "timeout", "input_mutation", "output_flood", "malformed_output"]},
    "source_paths_included": {"const": false},
    "commands_included": {"const": false},
    "network_destinations_included": {"const": false},
    "credentials_included": {"const": false},
    "authority_added": {"const": false}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_hash", "bytes", "media_type", "target_platform"],
      "properties": {
        "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "media_type": {"$ref": "common.schema.json#/$defs/schemaName"},
        "target_platform": {"type": "string", "enum": ["any", "windows", "macos", "linux"]}
      }
    }
  }
}
