{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/deterministic-context-plan.schema.json",
  "title": "Deterministic context plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "plan_id", "task_profile", "workspace_snapshot", "policy_decision", "steps", "coverage", "omitted_candidates"],
  "properties": {
    "schema_name": {"const": "deterministic-context-plan"},
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "task_profile": {"enum": ["orientation", "implementation", "bug_investigation", "change_review", "security_review", "test_selection", "configuration_change"]},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "policy_decision": {"$ref": "common.schema.json#/$defs/sha256"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/step"}},
    "coverage": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/coverage"}},
    "omitted_candidates": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/omission"}},
    "structural_query": {"$ref": "#/$defs/structuralQuery"},
    "declared_change_set": {"$ref": "#/$defs/declaredChangeSet"},
    "declared_associated_tests": {"$ref": "#/$defs/declaredAssociatedTests"},
    "declared_convention_exemplars": {"$ref": "#/$defs/declaredConventionExemplars"},
    "repository_orientation": {"$ref": "#/$defs/repositoryOrientation"}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "reason_code"],
      "properties": {
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "query"],
          "properties": {
            "kind": {"enum": ["exact_path", "filename", "literal", "lexical"]},
            "query": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_class", "status", "reason_code"],
      "properties": {
        "evidence_class": {"enum": ["exact_path", "filename", "literal", "lexical", "structural_relationship", "change_set", "associated_test", "configuration_to_code_reference", "repository_orientation", "convention_exemplar"]},
        "status": {"enum": ["available", "unavailable"]},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"}
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "reason_code", "count"],
      "properties": {
        "candidate": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"},
        "count": {"$ref": "common.schema.json#/$defs/unsignedDecimal"}
      }
    },
    "structuralQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "edge_kinds", "result"],
      "properties": {
        "query_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "edge_kinds": {"type": "array", "maxItems": 8, "items": {"enum": ["declares", "contains", "imports", "exports", "calls", "references"]}},
        "result": {"$ref": "structural-query.schema.json"}
      }
    },
    "declaredChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration_id", "workspace_snapshot", "base_revision_status", "entries"],
      "properties": {
        "declaration_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
        "asserted_base_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "base_revision_status": {"enum": ["not_asserted", "matched_repository_metadata", "unavailable_or_mismatched"]},
        "entries": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/declaredChangeEntry"}}
      }
    },
    "declaredChangeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash"],
      "properties": {
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform_family", "unit_encoding", "relative_units_base64url"],
          "properties": {
            "platform_family": {"enum": ["unix", "windows"]},
            "unit_encoding": {"enum": ["unix_bytes", "windows_utf16le"]},
            "relative_units_base64url": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9_-]+$"}
          }
        },
        "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "declaredAssociatedTests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["association_id", "workspace_snapshot", "associations"],
      "properties": {
        "association_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
        "associations": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/declaredAssociation"}}
      }
    },
    "declaredConventionExemplars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration_id", "workspace_snapshot", "exemplars"],
      "properties": {
        "declaration_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
        "exemplars": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/conventionExemplar"}}
      }
    },
    "conventionExemplar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "artifact"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact": {"$ref": "#/$defs/declaredChangeEntry"}
      }
    },
    "repositoryOrientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_id", "result"],
      "properties": {
        "map_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "result": {"$ref": "repository-map.schema.json"}
      }
    },
    "declaredAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "test"],
      "properties": {
        "source": {"$ref": "#/$defs/declaredChangeEntry"},
        "test": {"$ref": "#/$defs/declaredChangeEntry"}
      }
    }
  }
}
