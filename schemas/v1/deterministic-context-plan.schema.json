{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/deterministic-context-plan.schema.json",
  "title": "Deterministic context plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "plan_id", "task_profile", "workspace_snapshot", "policy_decision", "steps", "coverage", "omitted_candidates"],
  "properties": {
    "schema_name": {"const": "deterministic-context-plan"},
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "task_profile": {"enum": ["orientation", "implementation", "bug_investigation", "change_review", "security_review", "test_selection", "configuration_change"]},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "policy_decision": {"$ref": "common.schema.json#/$defs/sha256"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/step"}},
    "coverage": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/coverage"}},
    "omitted_candidates": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/omission"}}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "reason_code"],
      "properties": {
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "query"],
          "properties": {
            "kind": {"enum": ["exact_path", "filename", "literal", "lexical"]},
            "query": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_class", "status", "reason_code"],
      "properties": {
        "evidence_class": {"enum": ["exact_path", "filename", "literal", "lexical", "structural_relationship", "change_set", "associated_test", "configuration_to_code_reference"]},
        "status": {"enum": ["available", "unavailable"]},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"}
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "reason_code", "count"],
      "properties": {
        "candidate": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"},
        "count": {"$ref": "common.schema.json#/$defs/unsignedDecimal"}
      }
    }
  }
}
