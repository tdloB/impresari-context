{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/independent-security-review.schema.json",
  "title": "Independent human security review readiness and admission",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority": {
      "type": "object",
      "required": ["source_read", "source_write", "network", "credential_access", "process_execution", "tag_creation", "release_publication", "risk_acceptance"],
      "properties": {
        "source_read": {"const": "denied"}, "source_write": {"const": "denied"},
        "network": {"const": "denied"}, "credential_access": {"const": "denied"},
        "process_execution": {"const": "denied"}, "tag_creation": {"const": "denied"},
        "release_publication": {"const": "denied"}, "risk_acceptance": {"const": "denied"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["schema_name", "schema_version", "scope_id", "target_version", "product_source_commit", "status", "triggered_boundaries", "review_areas", "required_artifacts", "reviewer_requirements", "finding_policy", "claim", "safe_next_step"],
      "properties": {
        "schema_name": {"const": "independent-security-review-scope"},
        "schema_version": {"const": "1.0.0"},
        "scope_id": {"const": "impresari-context-v0-2-0-review-v1"},
        "target_version": {"const": "0.2.0"},
        "product_source_commit": {"$ref": "#/$defs/commit"},
        "status": {"enum": ["manual_review_required", "review_recorded"]},
        "triggered_boundaries": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["external_service_delivery_via_client_process", "authentication_configuration_reference", "child_process_supervision", "os_isolation_candidate"]}
        },
        "review_areas": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": {"enum": ["workspace_and_cache_isolation", "untrusted_repository_input", "parser_worker_process_boundary", "external_client_delivery_and_consent", "credential_reference_and_redaction", "configuration_install_update_remove", "analyzer_supervisor_and_linux_isolation", "release_supply_chain_and_claim_accuracy"]}
        },
        "required_artifacts": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:docs/[A-Za-z0-9._/-]+\\.md|SECURITY\\.md)$"}},
        "reviewer_requirements": {
          "type": "object",
          "required": ["human", "independent_of_implementation", "security_experience_required", "conflict_disclosure_required", "ai_assistance_may_not_be_the_reviewer", "attributable_report_required"],
          "properties": {
            "human": {"const": true}, "independent_of_implementation": {"const": true},
            "security_experience_required": {"const": true}, "conflict_disclosure_required": {"const": true},
            "ai_assistance_may_not_be_the_reviewer": {"const": true}, "attributable_report_required": {"const": true}
          },
          "additionalProperties": false
        },
        "finding_policy": {
          "type": "object",
          "required": ["critical_open_allowed", "high_open_allowed", "medium_open_requires_owner_disposition", "low_open_requires_documentation", "unknown_severity_allowed"],
          "properties": {
            "critical_open_allowed": {"const": false}, "high_open_allowed": {"const": false},
            "medium_open_requires_owner_disposition": {"const": true}, "low_open_requires_documentation": {"const": true},
            "unknown_severity_allowed": {"const": false}
          },
          "additionalProperties": false
        },
        "claim": {
          "type": "object",
          "required": ["review_gate_satisfied", "release_ready", "publication_authorized", "production_support_admitted", "real_analyzer_authorized"],
          "properties": {
            "review_gate_satisfied": {"type": "boolean"}, "release_ready": {"const": false},
            "publication_authorized": {"const": false}, "production_support_admitted": {"const": false},
            "real_analyzer_authorized": {"const": false}
          },
          "additionalProperties": false
        },
        "report": {
          "type": "object",
          "required": ["reviewer_reference", "independence_statement", "conflict_disclosure", "report_sha256", "reviewed_commit", "reviewed_at", "critical_open", "high_open", "medium_dispositions_complete", "low_documentation_complete"],
          "properties": {
            "reviewer_reference": {"type": "string", "minLength": 1, "maxLength": 200},
            "independence_statement": {"type": "string", "minLength": 1, "maxLength": 500},
            "conflict_disclosure": {"type": "string", "minLength": 1, "maxLength": 500},
            "report_sha256": {"$ref": "#/$defs/sha256"}, "reviewed_commit": {"$ref": "#/$defs/commit"},
            "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "critical_open": {"const": 0}, "high_open": {"const": 0},
            "medium_dispositions_complete": {"const": true}, "low_documentation_complete": {"const": true}
          },
          "additionalProperties": false
        },
        "safe_next_step": {"type": "string", "minLength": 1, "maxLength": 400}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "manual_review_required"}}}, "then": {"properties": {"claim": {"properties": {"review_gate_satisfied": {"const": false}}}}}},
        {"if": {"properties": {"status": {"const": "review_recorded"}}}, "then": {"required": ["report"], "properties": {"claim": {"properties": {"review_gate_satisfied": {"const": true}}}}}}
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["schema_name", "schema_version", "status", "reason_code", "scope_id", "target_version", "observed", "scope_identity", "checks", "safe_next_step", "review_gate_satisfied", "release_ready", "publication_authorized", "production_support_admitted", "real_analyzer_authorized", "authority"],
      "properties": {
        "schema_name": {"const": "independent-security-review-receipt"}, "schema_version": {"const": "1.0.0"},
        "status": {"enum": ["manual_review_required", "review_admitted", "changed", "missing_evidence", "invalid_review", "unsupported"]},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "scope_id": {"const": "impresari-context-v0-2-0-review-v1"}, "target_version": {"const": "0.2.0"},
        "observed": {
          "type": "object",
          "required": ["scope_available", "report_available", "reviewer_independent", "target_version", "product_source_commit", "report_sha256", "critical_open", "high_open"],
          "properties": {
            "scope_available": {"type": "boolean"}, "report_available": {"type": "boolean"},
            "reviewer_independent": {"type": "boolean"}, "target_version": {"type": "string", "maxLength": 40},
            "product_source_commit": {"type": "string", "maxLength": 40}, "report_sha256": {"type": "string", "maxLength": 64},
            "critical_open": {"type": "integer"}, "high_open": {"type": "integer"}
          },
          "additionalProperties": false
        },
        "scope_identity": {"$ref": "#/$defs/sha256"},
        "checks": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}},
        "safe_next_step": {"type": "string", "minLength": 1, "maxLength": 400},
        "review_gate_satisfied": {"type": "boolean"}, "release_ready": {"const": false},
        "publication_authorized": {"const": false}, "production_support_admitted": {"const": false},
        "real_analyzer_authorized": {"const": false}, "authority": {"$ref": "#/$defs/authority"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "review_admitted"}}}, "then": {"properties": {"review_gate_satisfied": {"const": true}}}},
        {"if": {"properties": {"status": {"enum": ["manual_review_required", "changed", "missing_evidence", "invalid_review", "unsupported"]}}}, "then": {"properties": {"review_gate_satisfied": {"const": false}}}}
      ],
      "additionalProperties": false
    }
  }
}
