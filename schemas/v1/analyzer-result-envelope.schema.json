{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/analyzer-result-envelope.schema.json",
  "title": "Bounded untrusted analyzer result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "workspace_snapshot", "requirement_id", "capability_id", "artifact_hashes", "ruleset_digest", "completed_at", "fresh_until", "findings", "safety_claimed", "ordinary_host_execution_authorized", "authority_added"],
  "properties": {
    "schema_name": {"const": "analyzer-result-envelope"},
    "schema_version": {"const": "1.0.0"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "requirement_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "capability_id": {"$ref": "common.schema.json#/$defs/schemaName"},
    "artifact_hashes": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sha256"}},
    "ruleset_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "completed_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "fresh_until": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "findings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/finding"}},
    "safety_claimed": {"const": false},
    "ordinary_host_execution_authorized": {"const": false},
    "authority_added": {"const": false}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_hash", "category", "severity", "confidence", "method"],
      "properties": {
        "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "category": {"type": "string", "enum": ["execution_surface", "lifecycle_hook", "code_download", "credential_path", "persistence", "privilege", "host_mount", "network_reference", "format_mismatch", "analyzer_detection", "unknown"]},
        "severity": {"type": "string", "enum": ["informational", "low", "medium", "high", "critical"]},
        "confidence": {"type": "string", "enum": ["confirmed", "high", "medium", "low", "unknown"]},
        "method": {"$ref": "common.schema.json#/$defs/schemaName"}
      }
    }
  }
}
