{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/security-finding.schema.json",
  "title": "Security-relevant observed or untrusted-derived finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "finding_id", "workspace_snapshot", "artifact_hash", "classification", "category", "severity", "confidence", "method", "trust", "limitations", "authority_added"],
  "properties": {
    "schema_name": {"const": "security-finding"},
    "schema_version": {"const": "1.0.0"},
    "finding_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "evidence_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "classification": {"type": "string", "enum": ["observed", "derived", "reputation_match", "heuristically_suspicious", "unknown"]},
    "category": {"type": "string", "enum": ["execution_surface", "lifecycle_hook", "code_download", "credential_path", "persistence", "privilege", "host_mount", "network_reference", "format_mismatch", "analyzer_detection", "unknown"]},
    "severity": {"type": "string", "enum": ["informational", "low", "medium", "high", "critical"]},
    "confidence": {"type": "string", "enum": ["confirmed", "high", "medium", "low", "unknown"]},
    "method": {"$ref": "common.schema.json#/$defs/schemaName"},
    "analyzer_identity": {"$ref": "common.schema.json#/$defs/sha256"},
    "ruleset_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "trust": {"type": "string", "enum": ["untrusted_workspace_content", "untrusted_derived_data"]},
    "limitations": {"$ref": "common.schema.json#/$defs/stringList"},
    "authority_added": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"classification": {"const": "observed"}}}, "then": {"required": ["evidence_id"]}},
    {"if": {"properties": {"classification": {"const": "derived"}}}, "then": {"required": ["analyzer_identity", "ruleset_digest"]}},
    {"if": {"properties": {"classification": {"const": "reputation_match"}}}, "then": {"required": ["analyzer_identity", "ruleset_digest"]}}
  ]
}
