{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/linux-isolation-feasibility.schema.json",
  "title": "ADR-0074 Linux IAR-1B feasibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "prototype_id", "profile_id", "profile_digest", "observed_host", "result", "preflight", "checks", "limitations", "os_confined", "production_admitted", "source_retained", "authority_added"],
  "properties": {
    "schema_name": {"const": "linux-isolation-feasibility"},
    "schema_version": {"const": "1.0.0"},
    "prototype_id": {"const": "iar-linux-isolation-feasibility-v1"},
    "profile_id": {"const": "iar-linux-synthetic-v1"},
    "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "kernel_release", "architecture", "landlock_abi"],
      "properties": {
        "operating_system": {"const": "linux"},
        "kernel_release": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$", "maxLength": 96},
        "architecture": {"enum": ["x86_64", "aarch64"]},
        "landlock_abi": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,2})$"}
      }
    },
    "result": {"enum": ["partial", "candidate_passed", "unsupported", "failed"]},
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_new_privs", "landlock", "seccomp_filter", "seccomp_kill_process", "architecture_filter", "cgroup_v2", "cpu_controller", "memory_controller", "pids_controller", "delegated_leaf", "cgroup_kill", "cgroup_empty_verification"],
      "properties": {
        "no_new_privs": {"type": "boolean"},
        "landlock": {"type": "boolean"},
        "seccomp_filter": {"type": "boolean"},
        "seccomp_kill_process": {"type": "boolean"},
        "architecture_filter": {"type": "boolean"},
        "cgroup_v2": {"type": "boolean"},
        "cpu_controller": {"type": "boolean"},
        "memory_controller": {"type": "boolean"},
        "pids_controller": {"type": "boolean"},
        "delegated_leaf": {"type": "boolean"},
        "cgroup_kill": {"type": "boolean"},
        "cgroup_empty_verification": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_new_privs_effective", "landlock_read_only_input", "external_filesystem_denial", "credential_denial", "device_denial", "network_denial", "unrelated_descriptors_closed", "descendant_denial", "zero_writable_filesystem", "cpu_limit", "memory_limit", "process_count_limit", "exact_cgroup_kill", "cgroup_empty_after_job", "bounded_output", "timeout", "crash_relaunch", "cleanup", "cross_job_isolation"],
      "properties": {
        "no_new_privs_effective": {"type": "boolean"},
        "landlock_read_only_input": {"type": "boolean"},
        "external_filesystem_denial": {"type": "boolean"},
        "credential_denial": {"type": "boolean"},
        "device_denial": {"type": "boolean"},
        "network_denial": {"type": "boolean"},
        "unrelated_descriptors_closed": {"type": "boolean"},
        "descendant_denial": {"type": "boolean"},
        "zero_writable_filesystem": {"type": "boolean"},
        "cpu_limit": {"type": "boolean"},
        "memory_limit": {"type": "boolean"},
        "process_count_limit": {"type": "boolean"},
        "exact_cgroup_kill": {"type": "boolean"},
        "cgroup_empty_after_job": {"type": "boolean"},
        "bounded_output": {"type": "boolean"},
        "timeout": {"type": "boolean"},
        "crash_relaunch": {"type": "boolean"},
        "cleanup": {"type": "boolean"},
        "cross_job_isolation": {"type": "boolean"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no-new-privs-unavailable",
          "landlock-unavailable",
          "seccomp-unavailable",
          "architecture-filter-unavailable",
          "cgroup-v2-unavailable",
          "required-cgroup-controller-unavailable",
          "cgroup-delegation-unavailable",
          "cgroup-resource-suite-pending",
          "lifecycle-suite-pending",
          "single-host-evidence",
          "synthetic-probe-no-analysis"
        ]
      }
    },
    "os_confined": {"type": "boolean"},
    "production_admitted": {"const": false},
    "source_retained": {"const": false},
    "authority_added": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "candidate_passed"}}, "required": ["result"]},
      "then": {
        "properties": {
          "preflight": {
            "properties": {
              "no_new_privs": {"const": true},
              "landlock": {"const": true},
              "seccomp_filter": {"const": true},
              "seccomp_kill_process": {"const": true},
              "architecture_filter": {"const": true},
              "cgroup_v2": {"const": true},
              "cpu_controller": {"const": true},
              "memory_controller": {"const": true},
              "pids_controller": {"const": true},
              "delegated_leaf": {"const": true},
              "cgroup_kill": {"const": true},
              "cgroup_empty_verification": {"const": true}
            }
          },
          "checks": {
            "properties": {
              "no_new_privs_effective": {"const": true},
              "landlock_read_only_input": {"const": true},
              "external_filesystem_denial": {"const": true},
              "credential_denial": {"const": true},
              "device_denial": {"const": true},
              "network_denial": {"const": true},
              "unrelated_descriptors_closed": {"const": true},
              "descendant_denial": {"const": true},
              "zero_writable_filesystem": {"const": true},
              "cpu_limit": {"const": true},
              "memory_limit": {"const": true},
              "process_count_limit": {"const": true},
              "exact_cgroup_kill": {"const": true},
              "cgroup_empty_after_job": {"const": true},
              "bounded_output": {"const": true},
              "timeout": {"const": true},
              "crash_relaunch": {"const": true},
              "cleanup": {"const": true},
              "cross_job_isolation": {"const": true}
            }
          },
          "os_confined": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"result": {"enum": ["partial", "unsupported", "failed"]}}, "required": ["result"]},
      "then": {"properties": {"os_confined": {"const": false}}}
    }
  ]
}
