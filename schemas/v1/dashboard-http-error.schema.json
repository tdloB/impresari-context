{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/dashboard-http-error.schema.json",
  "title": "Source-free dashboard HTTP error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "code"],
  "properties": {
    "schema_name": {"const": "dashboard-http-error"},
    "schema_version": {"const": "1.0.0"},
    "code": {
      "type": "string",
      "enum": ["invalid_configuration", "bind_failure", "audit_unavailable", "policy_unavailable", "resource_limit", "request_rejected", "internal_failure"]
    }
  }
}
