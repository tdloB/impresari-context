{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/yara-x-normalized-result.schema.json",
  "title": "ADR-0100 path-free source-free normalized YARA-X result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "result_id", "profile_id", "profile_digest", "workspace_snapshot", "manifest_id", "analyzer_id", "artifact_hash", "artifact_bytes", "executable_digest", "ruleset_digest", "completed_at", "observations", "complete_accounting", "limitations", "result_origin", "raw_output_retained", "source_bytes_retained", "matched_bytes_retained", "path_emitted", "analyzer_executed", "os_confined", "production_admitted", "iar_2_admitted", "safety_claimed", "authority_added"],
  "properties": {
    "schema_name": {"const": "yara-x-normalized-result"},
    "schema_version": {"const": "1.0.0"},
    "result_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "profile_id": {"const": "yara-x-ndjson-adapter-v1"},
    "profile_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "analyzer_id": {"const": "impresari.yara-x"},
    "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifact_bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
    "executable_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "ruleset_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "completed_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "observations": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/observation"}},
    "complete_accounting": {"const": true},
    "limitations": {"const": ["adapter-only", "no-live-analyzer", "not-a-safety-verdict", "original-synthetic-fixture"]},
    "result_origin": {"const": "original_synthetic_fixture"},
    "raw_output_retained": {"const": false},
    "source_bytes_retained": {"const": false},
    "matched_bytes_retained": {"const": false},
    "path_emitted": {"const": false},
    "analyzer_executed": {"const": false},
    "os_confined": {"const": false},
    "production_admitted": {"const": false},
    "iar_2_admitted": {"const": false},
    "safety_claimed": {"const": false},
    "authority_added": {"const": false}
  },
  "$defs": {
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_hash", "namespace", "rule_identifier", "tags", "ranges", "classification", "method", "trust", "limitations", "authority_added"],
      "properties": {
        "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "namespace": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "rule_identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "tags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}},
        "ranges": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/range"}},
        "classification": {"const": "untrusted_derived_data"},
        "method": {"const": "yara_x_ndjson_rule_observation_v1"},
        "trust": {"const": "untrusted_derived_data"},
        "limitations": {"const": ["original-synthetic-fixture", "rule-match-is-not-a-safety-verdict"]},
        "authority_added": {"const": false}
      }
    },
    "range": {
      "type": "object", "additionalProperties": false,
      "required": ["string_identifier", "offset", "length"],
      "properties": {
        "string_identifier": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "offset": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "length": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    }
  }
}
