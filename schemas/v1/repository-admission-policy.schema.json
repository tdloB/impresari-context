{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/repository-admission-policy.schema.json",
  "title": "Deterministic repository admission policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "policy_id", "policy_version", "policy_digest", "rules", "exception_authority", "authority_added"],
  "properties": {
    "schema_name": {"const": "repository-admission-policy"},
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "policy_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "policy_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "rules": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/rule"}},
    "exception_authority": {"const": "authorized_human_outside_context_core"},
    "authority_added": {"const": false}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "priority", "effect", "match_field", "match_values", "reason_code"],
      "properties": {
        "rule_id": {"$ref": "common.schema.json#/$defs/schemaName"},
        "priority": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "effect": {"type": "string", "enum": ["block", "manual_review", "require_analysis", "allow_isolated_eligibility"]},
        "match_field": {"type": "string", "enum": ["finding_category", "finding_severity", "finding_classification", "coverage_state", "assessment_completeness"]},
        "match_values": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/schemaName"}},
        "reason_code": {"$ref": "common.schema.json#/$defs/schemaName"},
        "quarantine_profile": {"$ref": "common.schema.json#/$defs/schemaName"}
      },
      "allOf": [
        {"if": {"properties": {"effect": {"const": "allow_isolated_eligibility"}}}, "then": {"required": ["quarantine_profile"]}}
      ]
    }
  }
}
