{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/yara-x-live-synthetic-envelope-control.schema.json",
  "title": "ADR-0102 live YARA-X synthetic envelope control",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "job_id", "profile_id", "profile_digest", "case_id", "launcher_path", "launcher_digest", "executable_path", "executable_digest", "ruleset_path", "ruleset_digest", "artifact_path", "artifact_digest", "artifact_bytes", "job_root", "cgroup_leaf", "external_canary", "credential_canary", "write_probe", "workspace_snapshot", "manifest_id", "completed_at", "authority_added"],
  "properties": {
    "schema_name": {"const": "yara-x-live-synthetic-envelope-control"},
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "profile_id": {"const": "yara-x-live-synthetic-envelope-v1"},
    "profile_digest": {"const": "sha256:b95bbe55b604c7e266bb620981b8e5c3fca052c22842222537b1b0effed7bbf0"},
    "case_id": {"enum": ["empty", "hex", "literal", "near-miss", "wide"]},
    "launcher_path": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "launcher_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "executable_path": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "executable_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "ruleset_path": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "ruleset_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifact_path": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifact_bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
    "job_root": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "cgroup_leaf": {"type": "string", "pattern": "^/sys/fs/cgroup/[^\\u0000]{1,4095}$"},
    "external_canary": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "credential_canary": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "write_probe": {"type": "string", "pattern": "^/[^\\u0000]{1,4095}$"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "completed_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "authority_added": {"const": false}
  }
}
