{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/declared-change-set.schema.json",
  "title": "Caller-declared current change set",
  "description": "Untrusted caller declaration that must be verified against an authorized current snapshot; it is not a historical diff.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "workspace_snapshot", "entries"],
  "properties": {
    "schema_name": {"const": "declared-change-set"},
    "schema_version": {"const": "1.0.0"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "asserted_base_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "entries": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash"],
      "properties": {
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform_family", "unit_encoding", "relative_units_base64url"],
          "properties": {
            "platform_family": {"enum": ["unix", "windows"]},
            "unit_encoding": {"enum": ["unix_bytes", "windows_utf16le"]},
            "relative_units_base64url": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9_-]+$"}
          }
        },
        "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
