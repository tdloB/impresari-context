{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/yara-x-synthetic-runner-envelope-receipt.schema.json",
  "title": "YARA-X Synthetic Runner Envelope Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "receipt_id", "job_id", "profile_id", "profile_digest", "emitter_digest", "launcher_digest", "stdout_digest", "stdout_bytes", "normalized_result_id", "case_id", "synthetic_emitter_executed", "synthetic_emitter_os_confined", "emitter_stderr_empty", "in_memory_composition_complete", "raw_output_retained", "job_removed", "cgroup_removed", "yara_x_executed", "analyzer_executed", "production_admitted", "iar_2_admitted", "detection_quality_claimed", "safety_claimed", "authority_added"],
  "properties": {
    "schema_name": {"const": "yara-x-synthetic-runner-envelope-receipt"},
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "job_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "profile_id": {"const": "yara-x-synthetic-runner-envelope-v1"},
    "profile_digest": {"const": "sha256:356f1ae13bec35ac41693936ddfe6856f8aad713d2a79b10b1de71557eb9a30b"},
    "emitter_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "launcher_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "stdout_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "stdout_bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
    "normalized_result_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "case_id": {"enum": ["valid-match", "valid-no-match"]},
    "synthetic_emitter_executed": {"const": true},
    "synthetic_emitter_os_confined": {"const": true},
    "emitter_stderr_empty": {"const": true},
    "in_memory_composition_complete": {"const": true},
    "raw_output_retained": {"const": false},
    "job_removed": {"const": true},
    "cgroup_removed": {"const": true},
    "yara_x_executed": {"const": false},
    "analyzer_executed": {"const": false},
    "production_admitted": {"const": false},
    "iar_2_admitted": {"const": false},
    "detection_quality_claimed": {"const": false},
    "safety_claimed": {"const": false},
    "authority_added": {"const": false}
  }
}
