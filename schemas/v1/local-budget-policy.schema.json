{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/local-budget-policy.schema.json",
  "title": "Narrowing-only local budget policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "policy_id", "revision", "created_at", "rules"],
  "properties": {
    "schema_name": {"const": "local-budget-policy"},
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "revision": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "created_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "expires_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "purpose": {
      "type": "string",
      "enum": ["orientation", "implementation", "bug_investigation", "change_review", "security_review", "test_selection", "configuration_change"]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {"$ref": "#/$defs/purpose"},
        "capability": {"$ref": "common.schema.json#/$defs/capability"}
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "max_evidence_items": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "max_files": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "max_excerpt_bytes_per_item": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "max_matches": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "max_traversal_depth": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "max_elapsed_ms": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "max_memory_bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "selector", "deny", "ceilings"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "selector": {"$ref": "#/$defs/selector"},
        "deny": {"type": "boolean"},
        "ceilings": {"$ref": "#/$defs/ceilings"}
      }
    }
  }
}
