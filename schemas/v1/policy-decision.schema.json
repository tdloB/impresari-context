{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/policy-decision.schema.json",
  "title": "Capability policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "decision_id", "request_id", "caller_id", "role", "purpose", "capability",
    "outcome", "reason_codes", "policy_profile", "evaluated_at"
  ],
  "properties": {
    "schema_name": {"const": "policy-decision"},
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "caller_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "role": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]*$"},
    "workspace_identity": {"$ref": "common.schema.json#/$defs/sha256"},
    "capability": {"$ref": "common.schema.json#/$defs/capability"},
    "outcome": {"type": "string", "enum": ["allow", "deny", "limit"]},
    "reason_codes": {"$ref": "common.schema.json#/$defs/stringList"},
    "policy_profile": {"$ref": "common.schema.json#/$defs/sha256"},
    "effective_budget": {"$ref": "resource-budget.schema.json"},
    "evaluated_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"}
  }
}
