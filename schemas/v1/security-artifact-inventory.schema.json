{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/security-artifact-inventory.schema.json",
  "title": "Evidence-only security artifact inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "inventory_id", "workspace_snapshot", "profile_digest", "generated_at", "completeness", "artifacts", "exclusions", "excluded_count", "authority_added"],
  "properties": {
    "schema_name": {"const": "security-artifact-inventory"},
    "schema_version": {"const": "1.0.0"},
    "inventory_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "profile_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "generated_at": {"$ref": "common.schema.json#/$defs/rfc3339Utc"},
    "completeness": {"$ref": "common.schema.json#/$defs/completeness"},
    "artifacts": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/artifact"}},
    "exclusions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/exclusion"}},
    "excluded_count": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
    "authority_added": {"const": false}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "content_hash", "byte_size", "format", "classes", "target_platforms", "classification", "analyzer_requirements", "limitations"],
      "properties": {
        "artifact_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "path": {"$ref": "path-identity.schema.json"},
        "content_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "byte_size": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
        "format": {"type": "string", "enum": ["text", "binary", "pe_candidate", "msi_candidate", "archive_candidate", "unknown"]},
        "classes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "enum": ["source", "script", "configuration", "archive", "document", "executable", "library", "installer", "unknown"]}},
        "target_platforms": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "enum": ["cross_platform", "linux", "macos", "windows"]}},
        "classification": {"type": "string", "enum": ["observed", "unknown"]},
        "analyzer_requirements": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/schemaName"}},
        "limitations": {"$ref": "common.schema.json#/$defs/stringList"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count"],
      "properties": {
        "reason": {"type": "string", "enum": ["policy_excluded", "oversized", "symlink", "special_file", "limit_reached", "read_failed", "changed_during_read", "profile_file_limit", "snapshot_mismatch"]},
        "count": {"$ref": "common.schema.json#/$defs/unsignedDecimal"}
      }
    }
  }
}
