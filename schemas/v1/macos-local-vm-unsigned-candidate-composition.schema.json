    "product_version": {"const": "0.2.0"}, "target": {"const": "aarch64-apple-darwin"},
    "material_projection_canonicalization": {"const": "label-tab-value-lf-header-then-sorted-path-tab-kind-tab-required-mode-tab-bytes-tab-prefixed-sha256-lf-v1"},
    "prospective_compound_identity": {"const": "sha256:39ae0afbb77eff80ff5308cc4fe811b7cc266b42d02b4457aa5295310908b11e"},
    "material_projection": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/member"}},
    "unresolved_gates": {"type": "object", "additionalProperties": false, "required": ["one_private_root", "simultaneous_component_custody", "complete_app_tree_assembled", "filesystem_modes_verified_in_candidate", "candidate_schema_satisfied", "release_identity_bound"], "properties": {"one_private_root": {"$ref": "#/$defs/falseClaim"}, "simultaneous_component_custody": {"$ref": "#/$defs/falseClaim"}, "complete_app_tree_assembled": {"$ref": "#/$defs/falseClaim"}, "filesystem_modes_verified_in_candidate": {"$ref": "#/$defs/falseClaim"}, "candidate_schema_satisfied": {"$ref": "#/$defs/falseClaim"}, "release_identity_bound": {"$ref": "#/$defs/falseClaim"}}},
    "controls": {"type": "object", "additionalProperties": false, "required": ["offline_validation", "repository_metadata_read", "network_access", "credential_access", "process_launch", "candidate_materialized", "app_assembled", "runnable_artifacts_retained", "apple_identity_access", "developer_id_signature_verified", "apple_notarization_verified", "cask_created", "bundle_installed", "vm_launch", "analyzer_execution", "production_admitted", "macos_iar_1b_admitted", "authority_added"], "properties": {"offline_validation": {"const": true}, "repository_metadata_read": {"const": true}, "network_access": {"$ref": "#/$defs/falseClaim"}, "credential_access": {"$ref": "#/$defs/falseClaim"}, "process_launch": {"$ref": "#/$defs/falseClaim"}, "candidate_materialized": {"$ref": "#/$defs/falseClaim"}, "app_assembled": {"$ref": "#/$defs/falseClaim"}, "runnable_artifacts_retained": {"$ref": "#/$defs/falseClaim"}, "apple_identity_access": {"$ref": "#/$defs/falseClaim"}, "developer_id_signature_verified": {"$ref": "#/$defs/falseClaim"}, "apple_notarization_verified": {"$ref": "#/$defs/falseClaim"}, "cask_created": {"$ref": "#/$defs/falseClaim"}, "bundle_installed": {"$ref": "#/$defs/falseClaim"}, "vm_launch": {"$ref": "#/$defs/falseClaim"}, "analyzer_execution": {"$ref": "#/$defs/falseClaim"}, "production_admitted": {"$ref": "#/$defs/falseClaim"}, "macos_iar_1b_admitted": {"$ref": "#/$defs/falseClaim"}, "authority_added": {"$ref": "#/$defs/falseClaim"}}}
  }
