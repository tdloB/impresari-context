{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/analyzer-execution-manifest.schema.json",
  "title": "IAR-0 synthetic analyzer execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "manifest_id", "analyzer_id", "analyzer_version", "publisher", "executable_digest", "ruleset_digest", "capability_ids", "host_platforms", "target_platforms", "network", "determinism", "result_schema", "revoked", "synthetic_only", "repository_supplied", "authority_added"],
  "properties": {
    "schema_name": {"const": "analyzer-execution-manifest"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "analyzer_id": {"$ref": "common.schema.json#/$defs/schemaName"},
    "analyzer_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "publisher": {"$ref": "common.schema.json#/$defs/safeMessage"},
    "executable_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "ruleset_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "capability_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/schemaName"}},
    "host_platforms": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["macos_arm64", "linux_x86_64", "windows_x86_64"]}},
    "target_platforms": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "enum": ["any", "windows", "macos", "linux"]}},
    "network": {"const": "none"},
    "determinism": {"const": "deterministic"},
    "result_schema": {"const": "analyzer-runner-result@1.0.0"},
    "revoked": {"const": false},
    "synthetic_only": {"const": true},
    "repository_supplied": {"const": false},
    "authority_added": {"const": false}
  }
}
