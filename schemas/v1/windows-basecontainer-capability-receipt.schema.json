{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/windows-basecontainer-capability-receipt.schema.json",
  "title": "ADR-0094 Windows BaseContainer no-worker capability receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "profile_id", "profile_digest", "runner_environment", "runner_label", "os_family", "os_product_type", "windows_build", "architecture", "filesystem", "system_module_inspected", "processmodel_dll_present", "create_process_in_sandbox_export_present", "create_process_as_user_in_sandbox_export_present", "status", "reason_code", "synthetic_worker_launched", "appcontainer_profile_created", "host_acl_modified", "windows_feature_modified", "elevation_requested", "os_confined", "production_admitted", "analyzer_execution", "authority_added"],
  "properties": {
    "schema_name": {"const": "windows-basecontainer-capability-receipt"},
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"const": "iar-windows-basecontainer-capability-v1"},
    "profile_digest": {"const": "sha256:9f5c8f589cf5f7ce3e6d87b6b7752aeac4da530a81edbb1bf036bf5eb7e84305"},
    "runner_environment": {"const": "github-hosted"},
    "runner_label": {"const": "windows-11-arm"},
    "os_family": {"const": "windows"},
    "os_product_type": {"enum": ["workstation", "domain_controller", "server"]},
    "windows_build": {"type": "string", "pattern": "^[0-9]{1,10}$"},
    "architecture": {"const": "arm64"},
    "filesystem": {"enum": ["ntfs", "other"]},
    "system_module_inspected": {"const": true},
    "processmodel_dll_present": {"type": "boolean"},
    "create_process_in_sandbox_export_present": {"type": "boolean"},
    "create_process_as_user_in_sandbox_export_present": {"type": "boolean"},
    "status": {"enum": ["ready_for_basecontainer_rehearsal", "unsupported"]},
    "reason_code": {"enum": ["candidate_capability_present", "unsupported_host_family", "unsupported_filesystem", "unsupported_build", "unsupported_api_absent"]},
    "synthetic_worker_launched": {"const": false},
    "appcontainer_profile_created": {"const": false},
    "host_acl_modified": {"const": false},
    "windows_feature_modified": {"const": false},
    "elevation_requested": {"const": false},
    "os_confined": {"const": false},
    "production_admitted": {"const": false},
    "analyzer_execution": {"const": false},
    "authority_added": {"const": false}
  }
}
