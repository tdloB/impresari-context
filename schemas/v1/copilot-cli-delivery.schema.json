{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/copilot-cli-delivery.schema.json",
  "title": "Explicit GitHub Copilot CLI programmatic-prompt delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "outcome", "reason_code", "client", "scope",
    "client_version", "protocol_scope", "request_id", "event_id", "client_io_performed",
    "terminal_result_observed", "tool_executions_observed", "provider_network_required",
    "source_workspace_exposed", "authenticated_copilot_home_used", "github_auth_config_used_in_place", "credential_state_copied",
    "credential_state_deleted", "authority_added"
  ],
  "properties": {
    "schema_name": {"const": "copilot-cli-delivery-receipt"},
    "schema_version": {"const": "1.0.0"},
    "outcome": {"enum": ["delivered", "no_delivery", "degraded"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$"},
    "client": {"const": "github_copilot_cli"},
    "scope": {"const": "programmatic_prompt"},
    "client_version": {"const": "1.0.80"},
    "protocol_scope": {"const": "programmatic_prompt_json_events_v1"},
    "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "event_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "packet_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "plan_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
    "client_io_performed": {"type": "boolean"},
    "terminal_result_observed": {"type": "boolean"},
    "tool_executions_observed": {"type": "integer", "minimum": 0},
    "provider_network_required": {"const": true},
    "source_workspace_exposed": {"const": false},
    "authenticated_copilot_home_used": {"type": "boolean"},
    "github_auth_config_used_in_place": {"type": "boolean"},
    "credential_state_copied": {"const": false},
    "credential_state_deleted": {"const": false},
    "authority_added": {"const": false}
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "packet_id", "packet_sha256", "packet_bytes_base64url", "task_query", "prompt"],
      "properties": {
        "schema_name": {"const": "copilot-cli-delivery-envelope"},
        "schema_version": {"const": "1.0.0"},
        "packet_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "packet_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "packet_bytes_base64url": {"type": "string", "minLength": 1, "maxLength": 699052, "pattern": "^[A-Za-z0-9_-]+$"},
        "task_query": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$"},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 786432, "pattern": "^[^\\u0000]*$"}
      }
    },
    "preparationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "outcome", "reason_code", "client", "scope", "client_version", "lifecycle_point", "request_id", "event_id", "workspace_identity", "packet_id", "plan_id", "workspace_snapshot", "policy_decision", "client_io_performed", "authority_added"],
      "properties": {
        "schema_name": {"const": "guided-delivery-receipt"},
        "schema_version": {"const": "1.0.0"},
        "outcome": {"const": "prepared"},
        "reason_code": {"const": "copilot_cli_packet_prepared"},
        "client": {"const": "github_copilot_cli"},
        "scope": {"const": "programmatic_prompt"},
        "client_version": {"const": "1.0.80"},
        "lifecycle_point": {"const": "prompt_start"},
        "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "event_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "workspace_identity": {"$ref": "common.schema.json#/$defs/sha256"},
        "packet_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "plan_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "workspace_snapshot": {"$ref": "common.schema.json#/$defs/sha256"},
        "policy_decision": {"$ref": "common.schema.json#/$defs/sha256"},
        "client_io_performed": {"const": false},
        "authority_added": {"const": false}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "client", "scope", "client_version", "protocol_scope", "prepared", "preparation_receipt", "delivery_envelope"],
      "properties": {
        "schema_name": {"const": "copilot-cli-delivery-preview"},
        "schema_version": {"const": "1.0.0"},
        "client": {"const": "github_copilot_cli"},
        "scope": {"const": "programmatic_prompt"},
        "client_version": {"const": "1.0.80"},
        "protocol_scope": {"const": "programmatic_prompt_json_events_v1"},
        "prepared": {"$ref": "guided-delivery.schema.json#/$defs/prepared"},
        "preparation_receipt": {"$ref": "#/$defs/preparationReceipt"},
        "delivery_envelope": {"$ref": "#/$defs/envelope"}
      }
    },
    "preparation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"const": "prepared"}, "value": {"$ref": "#/$defs/preview"}}},
        {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"const": "no_delivery"}, "value": {"$ref": "#"}}}
      ]
    }
  }
}
