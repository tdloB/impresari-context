{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/handoff-export.schema.json",
  "title": "Local immutable handoff export receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "packet_id", "destination_name", "exported_bytes", "authority_added"],
  "properties": {
    "schema_name": {"const": "handoff-export"},
    "schema_version": {"const": "1.0.0"},
    "packet_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "destination_name": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\\\u0000]+$"},
    "exported_bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
    "authority_added": {"const": false}
  }
}
