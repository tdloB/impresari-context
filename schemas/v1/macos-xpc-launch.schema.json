{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/macos-xpc-launch.schema.json",
  "title": "ADR-0074 source-free Rust-to-macOS-XPC launch handshake",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "request_id", "profile_id", "profile_digest", "job_digest", "artifacts", "total_artifact_bytes", "bundle_identifier", "host_relative_path", "service_name", "service_relative_path", "repository_path_present", "arguments_present", "environment_present", "credentials_present", "network_authorized", "analyzer_execution", "authority_added"],
      "properties": {
        "schema_name": {"const": "macos-xpc-launch-request"},
        "schema_version": {"const": "1.0.0"},
        "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "profile_id": {"const": "iar-macos-xpc-hybrid-v1"},
        "profile_digest": {"const": "sha256:7b33023031e84ac63e686054837cc20416e5e82cee333d7007fa1e1788581acf"},
        "job_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "artifacts": {"type": "string", "pattern": "^(0|[1-9]|[1-5][0-9]|6[0-4])$"},
        "total_artifact_bytes": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,5}|[1-3][0-9]{6}|40[0-9]{5}|41[0-8][0-9]{4}|419[0-3][0-9]{3}|4194[0-2][0-9]{2}|419430[0-4])$"},
        "bundle_identifier": {"const": "studio.boldthaus.impresari-context"},
        "host_relative_path": {"const": "Contents/MacOS/impresari-context-xpc-host"},
        "service_name": {"const": "studio.boldthaus.impresari-context.Analyzer"},
        "service_relative_path": {"const": "Contents/XPCServices/studio.boldthaus.impresari-context.Analyzer.xpc"},
        "repository_path_present": {"const": false},
        "arguments_present": {"const": false},
        "environment_present": {"const": false},
        "credentials_present": {"const": false},
        "network_authorized": {"const": false},
        "analyzer_execution": {"const": false},
        "authority_added": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"artifacts": {"const": "0"}}, "required": ["artifacts"]},
          "then": {"properties": {"total_artifact_bytes": {"const": "0"}}}
        },
        {
          "if": {"properties": {"total_artifact_bytes": {"const": "0"}}, "required": ["total_artifact_bytes"]},
          "then": {"properties": {"artifacts": {"const": "0"}}}
        }
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "request_id", "profile_id", "profile_digest", "job_digest", "host_process_id", "service_process_id", "bundle_identity_verified", "service_identity_verified", "effective_profile_verified", "network_entitlement_absent", "ready", "os_confined", "production_admitted", "source_retained", "authority_added"],
      "properties": {
        "schema_name": {"const": "macos-xpc-launch-preparation"},
        "schema_version": {"const": "1.0.0"},
        "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "profile_id": {"const": "iar-macos-xpc-hybrid-v1"},
        "profile_digest": {"const": "sha256:7b33023031e84ac63e686054837cc20416e5e82cee333d7007fa1e1788581acf"},
        "job_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "host_process_id": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 20},
        "service_process_id": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 20},
        "bundle_identity_verified": {"type": "boolean"},
        "service_identity_verified": {"type": "boolean"},
        "effective_profile_verified": {"type": "boolean"},
        "network_entitlement_absent": {"type": "boolean"},
        "ready": {"type": "boolean"},
        "os_confined": {"const": false},
        "production_admitted": {"const": false},
        "source_retained": {"const": false},
        "authority_added": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"ready": {"const": true}}, "required": ["ready"]},
          "then": {
            "properties": {
              "bundle_identity_verified": {"const": true},
              "service_identity_verified": {"const": true},
              "effective_profile_verified": {"const": true},
              "network_entitlement_absent": {"const": true}
            }
          }
        }
      ]
    }
  }
}
