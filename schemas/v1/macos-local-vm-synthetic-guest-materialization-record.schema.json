{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/macos-local-vm-synthetic-guest-materialization-record.schema.json",
  "title": "ADR-0112 macOS synthetic guest materialization record",
