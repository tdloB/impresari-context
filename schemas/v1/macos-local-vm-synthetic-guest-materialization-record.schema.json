    "contract_id": {"const": "iar-macos-local-vm-synthetic-guest-payload-2026-09-01.1"},
    "contract_digest": {"const": "sha256:4e43e28f325d7ab67ff2bb23595eb9273320ff5e8597553b9a681bfdc51033d4"},
    "profile_id": {"const": "iar-macos-local-vm-synthetic-guest-materialization-v1"},
