{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.impresari-context.invalid/v1/yara-x-live-synthetic-envelope-receipt.schema.json",
  "title": "ADR-0102 live YARA-X synthetic envelope receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "receipt_id", "job_id", "profile_id", "profile_digest", "case_id", "executable_digest", "ruleset_digest", "artifact_digest", "stdout_digest", "stdout_bytes", "normalized_result_id", "yara_x_executed", "os_confined", "in_memory_composition_complete", "synthetic_input_only", "raw_output_retained", "job_removed", "cgroup_removed", "executable_admitted", "ruleset_admitted", "production_admitted", "iar_2_admitted", "detection_quality_claimed", "safety_claimed", "authority_added"],
  "properties": {
    "schema_name": {"const": "yara-x-live-synthetic-envelope-receipt"},
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "job_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "profile_id": {"const": "yara-x-live-synthetic-envelope-v1"},
    "profile_digest": {"const": "sha256:2aa5e203f71089688baa41556c6775e7dcca98c7e6aab726442ff99fb5f8cd26"},
    "case_id": {"enum": ["empty", "hex", "literal", "near-miss", "wide"]},
    "executable_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "ruleset_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "stdout_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "stdout_bytes": {"$ref": "common.schema.json#/$defs/unsignedDecimal"},
    "normalized_result_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "yara_x_executed": {"const": true},
    "os_confined": {"const": true},
    "in_memory_composition_complete": {"const": true},
    "synthetic_input_only": {"const": true},
    "raw_output_retained": {"const": false},
    "job_removed": {"const": true},
    "cgroup_removed": {"const": true},
    "executable_admitted": {"const": false},
    "ruleset_admitted": {"const": false},
    "production_admitted": {"const": false},
    "iar_2_admitted": {"const": false},
    "detection_quality_claimed": {"const": false},
    "safety_claimed": {"const": false},
    "authority_added": {"const": false}
  }
}
